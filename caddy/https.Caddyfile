# Modo HTTPS (por defecto): Caddy obtiene el certificado automáticamente para APP_HOST.
# APP_HOST = <IP-con-guiones>.sslip.io (ej. 203-0-113-5.sslip.io)
{$APP_HOST} {
	encode gzip
	# API y salud -> FastAPI; todo lo demás -> interfaz Streamlit
	@api path /api/* /health /docs /openapi.json /chat
	handle @api {
		reverse_proxy app:8000
	}
	handle {
		reverse_proxy ui:8501
	}
}
