# Copia este archivo a .env y completa los valores
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

APP_NAME=Hack AI Agents
# Pack de sector: generico | banca | mineria | manufactura
SECTOR=generico
LOG_LEVEL=INFO
TZ=America/Lima
PORT=8000

# Despliegue
# Host público: <IP-con-guiones>.sslip.io (ej. 203-0-113-5.sslip.io). Caddy obtiene HTTPS solo.
APP_HOST=203-0-113-5.sslip.io
# https (por defecto) | http (plan B: HTTP directo en la IP, sin certificado)
CADDY_MODE=https

# Cliente LLM
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_THINKING=false
LLM_REASONING_EFFORT=high
